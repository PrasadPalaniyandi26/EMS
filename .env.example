# Read by Docker Compose only (docker-compose.yml). The API reads server/.env.
# Copy to .env (gitignored) and fill in. Never commit .env.

# Password for the ems user of the ems-db container. Applied once, when the
# ems-db-data volume is first created. Use the same value in DATABASE_URL in
# server/.env.
EMS_DB_PASSWORD=CHANGE_ME
