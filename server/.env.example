# ============================================
# Expense Manager — Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# --- JWT Authentication ---
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-jwt-secret-here
JWT_REFRESH_SECRET=your-strong-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Server ---
PORT=5000
NODE_ENV=development

# --- File Storage ---
# Windows example: UPLOAD_DIR=D:/Apps/Web/EMS-Storage
# macOS/Linux example: UPLOAD_DIR=/var/ems-storage
# Leave blank to use default relative path: server/uploads/
UPLOAD_DIR=

# --- Frontend Origin (for CORS) ---
CLIENT_URL=http://localhost:3000

# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fmhdb?schema=public"
