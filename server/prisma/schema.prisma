generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int        @id @default(autoincrement()) @map("role_id")
  name        String     @unique @map("role_name") @db.VarChar(50)
  description String?    @db.VarChar(255)
  accessLevel String?    @default("Standard") @map("access_level") @db.VarChar(20)
  userRoles   UserRole[]
  users       User[]

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model User {
  id                               Int                    @id @default(autoincrement())
  username                         String                 @unique @db.VarChar(50)
  email                            String                 @unique @db.VarChar(100)
  passwordHash                     String                 @map("password_hash") @db.VarChar(255)
  role                             String?                @default("user") @db.VarChar(10)
  roleId                           Int?                   @map("role_id")
  managerId                        Int?                   @map("manager_id")
  isActive                         Boolean                @default(true) @map("is_active")
  currency                         String?                @default("INR") @db.VarChar(3)
  department                       String?                @db.VarChar(100)
  clearanceLevel                   String?                @default("Level 1") @map("clearance_level") @db.VarChar(20)
  joiningDate                      DateTime?              @map("joining_date")
  createdAt                        DateTime               @default(now()) @map("created_at")
  contactNo                        String?                @map("contact_no") @db.VarChar(20)
  houseApt                         String?                @map("house_apt") @db.VarChar(100)
  address                          String?                @db.VarChar(255)
  city                             String?                @db.VarChar(100)
  country                          String?                @db.VarChar(100)
  postalCode                       String?                @map("postal_code") @db.VarChar(20)
  state                            String?                @db.VarChar(100)
  userStatus                       String?                @default("ACTIVE") @map("user_status") @db.VarChar(20)
  dateOfBirth                      DateTime?              @map("date_of_birth") @db.Date
  loginName                        String?                @unique @map("login_name") @db.VarChar(50)
  approvalReqs                     ApprovalRequest[]
  auditLogs                        AuditLog[]
  notifications                    Notification[]
  createdClients                   Client[]               @relation("ClientCreator")
  createdProdTypes                 ProductType[]          @relation("ProductTypeCreator")
  createdProducts                  Product[]              @relation("ProductCreator")
  products_products_lead_idTousers Product[]              @relation("products_lead_idTousers")
  createdProjTypes                 ProjectType[]          @relation("ProjectTypeCreator")
  createdProjects                  Project[]              @relation("ProjectCreator")
  projects_projects_lead_idTousers Project[]              @relation("projects_lead_idTousers")
  recurringTxns                    RecurringTransaction[]
  refreshTokens                    RefreshToken[]
  transactions                     Transaction[]
  allocations                      UserAllocation[]
  permissions                      UserPermission?
  transactionNotes                 TransactionNote[]
  userRoles                        UserRole[]
  manager                          User?                  @relation("UserManager", fields: [managerId], references: [id])
  subordinates                     User[]                 @relation("UserManager")
  roleRelation                     Role?                  @relation(fields: [roleId], references: [id])

  @@index([userStatus])
  @@map("users")
}

model UserAllocation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  clientId  Int      @map("client_id")
  category  String   @db.VarChar(20)
  type      String   @db.VarChar(50)
  code      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  client    Client   @relation(fields: [clientId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_allocations")
}

model UserPermission {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  permissions  Json     @default("{}")
  singleLimit  Decimal? @default(10000) @map("single_limit") @db.Decimal(14, 2)
  monthlyLimit Decimal? @default(50000) @map("monthly_limit") @db.Decimal(14, 2)
  dataScope    String?  @default("Department") @map("data_scope") @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_permissions")
}

model Category {
  id           Int                    @id @default(autoincrement())
  name         String                 @db.VarChar(50)
  code         String?                @db.VarChar(10)
  type         String                 @db.VarChar(10)
  icon         String?                @db.VarChar(50)
  isCustom     Boolean                @default(false) @map("is_custom")
  createdBy    Int?                   @map("created_by")
  isActive     Boolean                @default(true) @map("is_active")
  typeId       Int?                   @map("type_id")
  categoryType CategoryType?          @relation(fields: [typeId], references: [id], onDelete: SetNull)
  recurringTxn RecurringTransaction[]
  splits       TransactionSplit[]
  transactions Transaction[]

  @@index([typeId])
  @@map("categories")
}

model Transaction {
  id             Int                @id @default(autoincrement())
  userId         Int                @map("user_id")
  type           String             @db.VarChar(10)
  amount         Decimal            @db.Decimal(14, 2)
  dateRecorded   DateTime           @map("date_recorded") @db.Date
  categoryId     Int?               @map("category_id")
  description    String?            @db.VarChar(500)
  paymentMethod  String?            @default("cash") @map("payment_method") @db.VarChar(20)
  receiptPath    String?            @map("receipt_path") @db.VarChar(255)
  clientId       Int?               @map("client_id")
  projectId      Int?               @map("project_id")
  isSplit        Boolean            @default(false) @map("is_split")
  referenceId    String?            @unique @map("reference_id") @db.VarChar(20)
  receiptNumber  String?            @map("receipt_number") @db.VarChar(50)
  submittedAt    DateTime?          @map("submitted_at")
  status         String?            @default("DRAFT") @db.VarChar(20)
  productId      Int?               @map("product_id")
  departmentId   Int?               @map("department_id")
  budgetLineId   Int?               @map("budget_line_id")
  overBudgetReason String?          @map("over_budget_reason") @db.VarChar(500)
  contextType    String?            @default("project") @map("context_type") @db.VarChar(10)
  currency       String?            @default("INR") @db.VarChar(3)
  gstRate        Decimal?           @map("gst_rate") @db.Decimal(5, 2)
  gstIncluded    Boolean            @default(false) @map("gst_included")
  netAmount      Decimal?           @map("net_amount") @db.Decimal(14, 2)
  totalAmount    Decimal?           @map("total_amount") @db.Decimal(14, 2)
  isClaimable         Boolean            @default(false) @map("is_claimable")
  needsReimbursement  Boolean            @default(false) @map("needs_reimbursement")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at")
  approvedById   Int?               @map("approved_by_id")
  approvedByName String?            @map("approved_by_name") @db.VarChar(100)
  approvedByRole String?            @map("approved_by_role") @db.VarChar(50)
  approvedAt     DateTime?          @map("approved_at") @db.Timestamptz(6)
  rejectedById   Int?               @map("rejected_by_id")
  rejectedByName String?            @map("rejected_by_name") @db.VarChar(100)
  rejectedByRole String?            @map("rejected_by_role") @db.VarChar(50)
  rejectedAt     DateTime?          @map("rejected_at") @db.Timestamptz(6)
  submittedById  Int?               @map("submitted_by_id")
  submittedByName String?           @map("submitted_by_name") @db.VarChar(100)
  sentBackById   Int?               @map("sent_back_by_id")
  sentBackByName String?            @map("sent_back_by_name") @db.VarChar(100)
  sentBackByRole String?            @map("sent_back_by_role") @db.VarChar(50)
  sentBackAt              DateTime?          @map("sent_back_at") @db.Timestamptz(6)
  recurringTransactionId  Int?               @map("recurring_transaction_id")
  voidedById              Int?               @map("voided_by_id")
  voidedByName            String?            @map("voided_by_name") @db.VarChar(100)
  voidedAt                DateTime?          @map("voided_at") @db.Timestamptz(6)
  voidReason              String?            @map("void_reason") @db.VarChar(500)
  reimbursementStatus     String?            @map("reimbursement_status") @db.VarChar(20)
  reimbursedAt            DateTime?          @map("reimbursed_at") @db.Timestamptz(6)
  reimbursedById          Int?               @map("reimbursed_by_id")
  reimbursedByName        String?            @map("reimbursed_by_name") @db.VarChar(100)
  reimbursementReference  String?            @map("reimbursement_reference") @db.VarChar(150)
  reimbursementNote       String?            @map("reimbursement_note") @db.VarChar(500)
  approvals      ApprovalRequest[]
  notes          TransactionNote[]
  splits         TransactionSplit[]
  category       Category?          @relation(fields: [categoryId], references: [id])
  client         Client?            @relation(fields: [clientId], references: [id])
  product        Product?           @relation(fields: [productId], references: [id])
  project        Project?           @relation(fields: [projectId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id])
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dateRecorded])
  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([clientId])
  @@index([projectId])
  @@index([productId])
  @@index([departmentId])
  @@index([contextType])
  @@index([userId, status, type])
  @@map("transactions")
}

model TransactionNote {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  userId        Int         @map("user_id")
  note          String      @db.VarChar(1000)
  createdAt     DateTime    @default(now()) @map("created_at")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@index([transactionId])
  @@map("transaction_notes")
}

model TransactionSplit {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  categoryId    Int         @map("category_id")
  amount        Decimal     @db.Decimal(14, 2)
  description   String?     @db.VarChar(255)
  clientId      Int?        @map("client_id")
  projectId     Int?        @map("project_id")
  productId     Int?        @map("product_id")
  category      Category    @relation(fields: [categoryId], references: [id])
  client        Client?     @relation(fields: [clientId], references: [id])
  project       Project?    @relation(fields: [projectId], references: [id])
  product       Product?    @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_splits")
}

model Client {
  id           Int                    @id @default(autoincrement())
  name         String                 @unique @db.VarChar(100)
  description  String?                @db.VarChar(500)
  isActive     Boolean                @default(true) @map("is_active")
  isSystem     Boolean                @default(false) @map("is_system")
  createdBy    Int?                   @map("created_by")
  createdAt    DateTime               @default(now()) @map("created_at")
  address      String?                @db.VarChar(500)
  contactName  String?                @map("contact_name") @db.VarChar(100)
  contactEmail String?                @map("contact_email") @db.VarChar(200)
  contactPhone String?                @map("contact_phone") @db.VarChar(30)
  businessType String?                @map("business_type") @db.VarChar(100)
  code         String?                @db.VarChar(20)
  country      String?                @db.VarChar(100)
  street       String?                @db.VarChar(200)
  addressLine2 String?                @map("address_line2") @db.VarChar(200)
  city         String?                @db.VarChar(100)
  state        String?                @db.VarChar(100)
  postalCode   String?                @map("postal_code") @db.VarChar(20)
  creator      User?                  @relation("ClientCreator", fields: [createdBy], references: [id])
  products     Product[]
  projects     Project[]
  recurringTxn   RecurringTransaction[]
  transactions   Transaction[]
  allocations    UserAllocation[]
  splitLines     TransactionSplit[]

  @@map("clients")
}

model ProjectType {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  code      String?   @db.VarChar(10)
  isActive  Boolean   @default(true) @map("is_active")
  createdBy Int?      @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  creator   User?     @relation("ProjectTypeCreator", fields: [createdBy], references: [id])
  projects  Project[]
  categories ProjectCategory[]

  @@unique([name])
  @@map("project_types")
}

model ClientSector {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("client_sectors")
}

model ProjectCategory {
  id        Int         @id @default(autoincrement())
  typeId    Int         @map("type_id")
  name      String      @db.VarChar(100)
  code      String?     @db.VarChar(10)
  isActive  Boolean     @default(true) @map("is_active")
  createdBy Int?        @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  type      ProjectType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, name])
  @@index([typeId])
  @@map("project_categories")
}

model Project {
  id                            Int                    @id @default(autoincrement())
  clientId                      Int                    @map("client_id")
  typeId                        Int?                   @map("type_id")
  name                          String                 @db.VarChar(100)
  description                   String?                @db.VarChar(500)
  isActive                      Boolean                @default(true) @map("is_active")
  isSystem                      Boolean                @default(false) @map("is_system")
  createdBy                     Int?                   @map("created_by")
  createdAt                     DateTime               @default(now()) @map("created_at")
  code                          String?                @unique @db.VarChar(20)
  status                        String?                @default("Active") @db.VarChar(30)
  lead_id                       Int?
  budget                        Decimal?               @db.Decimal(14, 2)
  start_date                    DateTime?              @db.Date
  end_date                      DateTime?              @db.Date
  category                      String?                @db.VarChar(100)
  client                        Client                 @relation(fields: [clientId], references: [id])
  creator                       User?                  @relation("ProjectCreator", fields: [createdBy], references: [id])
  users_projects_lead_idTousers User?                  @relation("projects_lead_idTousers", fields: [lead_id], references: [id], onUpdate: NoAction)
  type                          ProjectType?           @relation(fields: [typeId], references: [id])
  recurringTxn                  RecurringTransaction[]
  transactions                  Transaction[]
  splitLines                    TransactionSplit[]

  @@unique([clientId, name])
  @@index([typeId])
  @@map("projects")
}

model ProductType {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  code      String?   @db.VarChar(10)
  isActive  Boolean   @default(true) @map("is_active")
  createdBy Int?      @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  creator   User?     @relation("ProductTypeCreator", fields: [createdBy], references: [id])
  products  Product[]
  categories ProductCategory[]

  @@unique([name])
  @@map("product_types")
}

model ProductCategory {
  id        Int         @id @default(autoincrement())
  typeId    Int         @map("type_id")
  name      String      @db.VarChar(100)
  code      String?     @db.VarChar(10)
  isActive  Boolean     @default(true) @map("is_active")
  createdBy Int?        @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  type      ProductType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, name])
  @@index([typeId])
  @@map("product_categories")
}

model Product {
  id                            Int                    @id @default(autoincrement())
  clientId                      Int                    @map("client_id")
  typeId                        Int?                   @map("type_id")
  name                          String                 @db.VarChar(100)
  description                   String?                @db.VarChar(500)
  isActive                      Boolean                @default(true) @map("is_active")
  isSystem                      Boolean                @default(false) @map("is_system")
  createdBy                     Int?                   @map("created_by")
  createdAt                     DateTime               @default(now()) @map("created_at")
  code                          String?                @unique @db.VarChar(20)
  status                        String?                @default("R&D") @db.VarChar(30)
  lead_id                       Int?
  budget                        Decimal?               @db.Decimal(14, 2)
  start_date                    DateTime?              @db.Date
  end_date                      DateTime?              @db.Date
  category                      String?                @db.VarChar(100)
  client                        Client                 @relation(fields: [clientId], references: [id])
  creator                       User?                  @relation("ProductCreator", fields: [createdBy], references: [id])
  users_products_lead_idTousers User?                  @relation("products_lead_idTousers", fields: [lead_id], references: [id], onUpdate: NoAction)
  type                          ProductType?           @relation(fields: [typeId], references: [id])
  recurringTxn                  RecurringTransaction[]
  transactions                  Transaction[]
  splitLines                    TransactionSplit[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([typeId])
  @@map("products")
}

model RecurringTransaction {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  amount           Decimal   @db.Decimal(14, 2)
  categoryId       Int       @map("category_id")
  description      String?   @db.VarChar(500)
  paymentMethod    String?   @default("cash") @map("payment_method") @db.VarChar(20)
  frequency        String?   @default("monthly") @db.VarChar(20)
  nextRunDate      DateTime  @map("next_run_date") @db.Date
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  type             String    @default("expense") @db.VarChar(10)
  status           String?   @default("DRAFT") @db.VarChar(20)
  lastRunDate      DateTime? @map("last_run_date") @db.Timestamptz(6)
  clientId         Int?      @map("client_id")
  projectId        Int?      @map("project_id")
  productId        Int?      @map("product_id")
  departmentId     Int?      @map("department_id")
  renewalDate      DateTime? @map("renewal_date") @db.Date
  escalationPct    Decimal?  @map("escalation_pct") @db.Decimal(5, 2)
  contextType      String?   @default("project") @map("context_type") @db.VarChar(10)
  currency         String?   @default("INR") @db.VarChar(3)
  gstRate          Decimal?  @map("gst_rate") @db.Decimal(5, 2)
  gstIncluded      Boolean   @default(false) @map("gst_included")
  netAmount        Decimal?  @map("net_amount") @db.Decimal(14, 2)
  totalAmount      Decimal?  @map("total_amount") @db.Decimal(14, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  code             String?   @db.VarChar(20)
  submittedByName  String?   @map("submitted_by_name") @db.VarChar(100)
  approvedById     Int?      @map("approved_by_id")
  approvedByName   String?   @map("approved_by_name") @db.VarChar(100)
  approvedByRole   String?   @map("approved_by_role") @db.VarChar(50)
  rejectedById     Int?      @map("rejected_by_id")
  rejectedByName   String?   @map("rejected_by_name") @db.VarChar(100)
  rejectedByRole   String?   @map("rejected_by_role") @db.VarChar(50)
  sentBackById     Int?      @map("sent_back_by_id")
  sentBackByName   String?   @map("sent_back_by_name") @db.VarChar(100)
  sentBackByRole   String?   @map("sent_back_by_role") @db.VarChar(50)
  category         Category      @relation(fields: [categoryId], references: [id])
  client           Client?       @relation(fields: [clientId], references: [id])
  product          Product?      @relation(fields: [productId], references: [id])
  project          Project?      @relation(fields: [projectId], references: [id])
  user             User          @relation(fields: [userId], references: [id])
  transactions     Transaction[]
  approvalReqs     ApprovalRequest[]

  @@index([userId])
  @@index([nextRunDate])
  @@index([isActive, nextRunDate])
  @@map("recurring_transactions")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  tableName   String   @map("table_name") @db.VarChar(50)
  recordId    Int      @map("record_id")
  referenceId String?  @map("reference_id") @db.VarChar(20)
  action      String   @db.VarChar(10)
  changedBy   Int      @map("changed_by")
  changedAt   DateTime @default(now()) @map("changed_at")
  oldValues   String?  @map("old_values")
  newValues   String?  @map("new_values")
  user        User     @relation(fields: [changedBy], references: [id])

  @@index([tableName])
  @@index([changedAt])
  @@index([changedBy])
  @@map("audit_log")
}

model ApprovalRule {
  id             Int     @id @default(autoincrement()) @map("rule_id")
  conditionType  String  @map("condition_type") @db.VarChar(50)
  conditionValue String  @map("condition_value") @db.VarChar(100)
  requiredLevels Int     @default(1) @map("required_levels") @db.SmallInt
  targetRoles    String? @map("target_roles") @db.VarChar(500)

  @@map("approval_rules")
}

model ApprovalRequest {
  id                     Int                   @id @default(autoincrement()) @map("request_id")
  transactionId          Int?                  @map("transaction_id")
  recurringTransactionId Int?                  @map("recurring_transaction_id")
  approverId             Int?                  @map("approver_id")
  levelNum               Int                   @map("level_num") @db.SmallInt
  status                 String?               @default("PENDING") @db.VarChar(20)
  comments               String?               @db.VarChar(1000)
  actionDate             DateTime?             @map("action_date")
  createdAt              DateTime              @default(now()) @map("created_at")
  resolvedAt             DateTime?             @map("resolved_at")
  approver               User?                 @relation(fields: [approverId], references: [id])
  transaction            Transaction?          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([recurringTransactionId])
  @@index([approverId])
  @@map("approval_requests")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String   @default("info") @db.VarChar(50)
  title       String   @db.VarChar(200)
  message     String?
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    Int?     @map("entity_id")
  referenceId String?  @map("reference_id") @db.VarChar(20)
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  ownerId   Int?     @map("owner_id")
  transactions Transaction[]
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("departments")
}

// Groups expense or income categories: Type > Category, e.g. Facilities > Rent
model CategoryType {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(50)
  kind       String     @db.VarChar(10)
  code       String?    @db.VarChar(10)
  appliesTo  String?    @map("applies_to") @db.VarChar(40)
  isActive   Boolean    @default(true) @map("is_active")
  createdBy  Int?       @map("created_by")
  createdAt  DateTime   @default(now()) @map("created_at")
  categories Category[]

  @@unique([kind, name])
  @@map("category_types")
}

// ── Budget control ──────────────────────────────────────────────────────────

// One row (id 1): company-wide budget rules
model BudgetSetting {
  id                Int      @id @default(1)
  fyStartMonth      Int      @default(4) @map("fy_start_month") @db.SmallInt
  overBudgetMode    String   @default("WARN") @map("over_budget_mode") @db.VarChar(10)
  controlLevel      String   @default("TYPE") @map("control_level") @db.VarChar(10)
  netOfClaimableGst Boolean  @default(true) @map("net_of_claimable_gst")
  approvalThreshold Decimal  @default(100000) @map("approval_threshold") @db.Decimal(14, 2)
  contingencyPct    Decimal  @default(10) @map("contingency_pct") @db.Decimal(5, 2)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("budget_settings")
}

// One plan per financial year; fy is the calendar year in which it starts (2026 = FY 2026-27)
model BudgetPlan {
  id             Int          @id @default(autoincrement())
  fy             Int          @unique
  name           String       @db.VarChar(100)
  status         String       @default("DRAFT") @db.VarChar(15)
  envelope       Decimal?     @db.Decimal(14, 2)
  version        Int          @default(1)
  submittedAt    DateTime?    @map("submitted_at")
  submittedByName String?     @map("submitted_by_name") @db.VarChar(100)
  approvedAt     DateTime?    @map("approved_at")
  approvedById   Int?         @map("approved_by_id")
  approvedByName String?      @map("approved_by_name") @db.VarChar(100)
  decisionNote   String?      @map("decision_note") @db.VarChar(500)
  createdBy      Int?         @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  lines          BudgetLine[]

  @@map("budget_plans")
}

// One cost object x one expense type, phased by month
model BudgetLine {
  id             Int                @id @default(autoincrement())
  planId         Int                @map("plan_id")
  costObject     String             @map("cost_object") @db.VarChar(12)
  projectId      Int?               @map("project_id")
  productId      Int?               @map("product_id")
  departmentId   Int?               @map("department_id")
  typeId         Int?               @map("type_id")
  categoryId     Int?               @map("category_id")
  controlLevel   String             @default("TYPE") @map("control_level") @db.VarChar(10)
  strict         Boolean            @default(false)
  isContingency  Boolean            @default(false) @map("is_contingency")
  ownerId        Int?               @map("owner_id")
  note           String?            @db.VarChar(500)
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at")
  plan           BudgetPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  periods        BudgetLinePeriod[]

  @@index([planId])
  @@index([projectId])
  @@index([productId])
  @@index([departmentId])
  @@index([typeId])
  @@map("budget_lines")
}

model BudgetLinePeriod {
  id     Int        @id @default(autoincrement())
  lineId Int        @map("line_id")
  year   Int        @db.SmallInt
  month  Int        @db.SmallInt
  amount Decimal    @default(0) @db.Decimal(14, 2)
  line   BudgetLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, year, month])
  @@map("budget_line_periods")
}

model BudgetAlertRule {
  code      String   @id @db.VarChar(30)
  name      String   @db.VarChar(100)
  detail    String?  @db.VarChar(300)
  enabled   Boolean  @default(true)
  threshold Decimal? @db.Decimal(8, 2)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("budget_alert_rules")
}

// One open alert per rule and line; it escalates instead of repeating and closes when the condition clears
model BudgetAlert {
  id         Int       @id @default(autoincrement())
  ruleCode   String    @map("rule_code") @db.VarChar(30)
  lineId     Int?      @map("line_id")
  level      String    @db.VarChar(10)
  message    String    @db.VarChar(300)
  action     String?   @db.VarChar(30)
  ownerId    Int?      @map("owner_id")
  status     String    @default("OPEN") @db.VarChar(10)
  openedAt   DateTime  @default(now()) @map("opened_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([status])
  @@index([lineId])
  @@map("budget_alerts")
}
