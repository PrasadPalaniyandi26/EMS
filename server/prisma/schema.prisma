generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int        @id @default(autoincrement()) @map("role_id")
  name        String     @unique @map("role_name") @db.VarChar(50)
  description String?    @db.VarChar(255)
  accessLevel String?    @default("Standard") @map("access_level") @db.VarChar(20)
  userRoles   UserRole[]
  users       User[]

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model User {
  id                               Int                    @id @default(autoincrement())
  username                         String                 @unique @db.VarChar(50)
  email                            String                 @unique @db.VarChar(100)
  passwordHash                     String                 @map("password_hash") @db.VarChar(255)
  role                             String?                @default("user") @db.VarChar(10)
  roleId                           Int?                   @map("role_id")
  managerId                        Int?                   @map("manager_id")
  isActive                         Boolean                @default(true) @map("is_active")
  currency                         String?                @default("INR") @db.VarChar(3)
  department                       String?                @db.VarChar(100)
  clearanceLevel                   String?                @default("Level 1") @map("clearance_level") @db.VarChar(20)
  joiningDate                      DateTime?              @map("joining_date")
  createdAt                        DateTime               @default(now()) @map("created_at")
  contactNo                        String?                @map("contact_no") @db.VarChar(20)
  houseApt                         String?                @map("house_apt") @db.VarChar(100)
  address                          String?                @db.VarChar(255)
  city                             String?                @db.VarChar(100)
  country                          String?                @db.VarChar(100)
  postalCode                       String?                @map("postal_code") @db.VarChar(20)
  state                            String?                @db.VarChar(100)
  userStatus                       String?                @default("ACTIVE") @map("user_status") @db.VarChar(20)
  dateOfBirth                      DateTime?              @map("date_of_birth") @db.Date
  loginName                        String?                @unique @map("login_name") @db.VarChar(50)
  approvalReqs                     ApprovalRequest[]
  auditLogs                        AuditLog[]
  notifications                    Notification[]
  createdClients                   Client[]               @relation("ClientCreator")
  createdProdTypes                 ProductType[]          @relation("ProductTypeCreator")
  createdProducts                  Product[]              @relation("ProductCreator")
  products_products_lead_idTousers Product[]              @relation("products_lead_idTousers")
  createdProjTypes                 ProjectType[]          @relation("ProjectTypeCreator")
  createdProjects                  Project[]              @relation("ProjectCreator")
  projects_projects_lead_idTousers Project[]              @relation("projects_lead_idTousers")
  recurringTxns                    RecurringTransaction[]
  refreshTokens                    RefreshToken[]
  transactions                     Transaction[]
  allocations                      UserAllocation[]
  permissions                      UserPermission?
  transactionNotes                 TransactionNote[]
  userRoles                        UserRole[]
  manager                          User?                  @relation("UserManager", fields: [managerId], references: [id])
  subordinates                     User[]                 @relation("UserManager")
  roleRelation                     Role?                  @relation(fields: [roleId], references: [id])

  @@index([userStatus])
  @@index([managerId])
  @@map("users")
}

model UserAllocation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  clientId  Int      @map("client_id")
  category  String   @db.VarChar(20)
  type      String   @db.VarChar(50)
  code      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  client    Client   @relation(fields: [clientId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_allocations")
}

model UserPermission {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  permissions  Json     @default("{}")
  singleLimit  Decimal? @default(10000) @map("single_limit") @db.Decimal(14, 2)
  monthlyLimit Decimal? @default(50000) @map("monthly_limit") @db.Decimal(14, 2)
  dataScope    String?  @default("Department") @map("data_scope") @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_permissions")
}

model Category {
  id           Int                    @id @default(autoincrement())
  name         String                 @db.VarChar(50)
  code         String?                @db.VarChar(10)
  type         String                 @db.VarChar(10)
  icon         String?                @db.VarChar(50)
  isCustom     Boolean                @default(false) @map("is_custom")
  createdBy    Int?                   @map("created_by")
  isActive     Boolean                @default(true) @map("is_active")
  typeId       Int?                   @map("type_id")
  categoryType CategoryType?          @relation(fields: [typeId], references: [id], onDelete: SetNull)
  recurringTxn RecurringTransaction[]
  splits       TransactionSplit[]
  transactions Transaction[]

  @@index([typeId])
  @@map("categories")
  stockItems Item[]
  stockMoves StockMove[]
}

model Transaction {
  id                     Int                   @id @default(autoincrement())
  userId                 Int                   @map("user_id")
  type                   String                @db.VarChar(10)
  amount                 Decimal               @db.Decimal(14, 2)
  dateRecorded           DateTime              @map("date_recorded") @db.Date
  categoryId             Int?                  @map("category_id")
  description            String?               @db.VarChar(500)
  paymentMethod          String?               @default("cash") @map("payment_method") @db.VarChar(20)
  receiptPath            String?               @map("receipt_path") @db.VarChar(255)
  clientId               Int?                  @map("client_id")
  projectId              Int?                  @map("project_id")
  isSplit                Boolean               @default(false) @map("is_split")
  referenceId            String?               @unique @map("reference_id") @db.VarChar(20)
  receiptNumber          String?               @map("receipt_number") @db.VarChar(50)
  submittedAt            DateTime?             @map("submitted_at")
  status                 String?               @default("DRAFT") @db.VarChar(20)
  productId              Int?                  @map("product_id")
  departmentId           Int?                  @map("department_id")
  budgetLineId           Int?                  @map("budget_line_id")
  // Product expenses only: the customer order the money was spent on, so its actual cost can be compared with the plan
  buildOrderId           Int?                  @map("build_order_id")
  overBudgetReason       String?               @map("over_budget_reason") @db.VarChar(500)
  contextType            String?               @default("project") @map("context_type") @db.VarChar(10)
  currency               String?               @default("INR") @db.VarChar(3)
  gstRate                Decimal?              @map("gst_rate") @db.Decimal(5, 2)
  gstIncluded            Boolean               @default(false) @map("gst_included")
  netAmount              Decimal?              @map("net_amount") @db.Decimal(14, 2)
  totalAmount            Decimal?              @map("total_amount") @db.Decimal(14, 2)
  isClaimable            Boolean               @default(false) @map("is_claimable")
  needsReimbursement     Boolean               @default(false) @map("needs_reimbursement")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @default(now()) @updatedAt @map("updated_at")
  approvedById           Int?                  @map("approved_by_id")
  approvedByName         String?               @map("approved_by_name") @db.VarChar(100)
  approvedByRole         String?               @map("approved_by_role") @db.VarChar(50)
  approvedAt             DateTime?             @map("approved_at") @db.Timestamptz(6)
  rejectedById           Int?                  @map("rejected_by_id")
  rejectedByName         String?               @map("rejected_by_name") @db.VarChar(100)
  rejectedByRole         String?               @map("rejected_by_role") @db.VarChar(50)
  rejectedAt             DateTime?             @map("rejected_at") @db.Timestamptz(6)
  submittedById          Int?                  @map("submitted_by_id")
  submittedByName        String?               @map("submitted_by_name") @db.VarChar(100)
  sentBackById           Int?                  @map("sent_back_by_id")
  sentBackByName         String?               @map("sent_back_by_name") @db.VarChar(100)
  sentBackByRole         String?               @map("sent_back_by_role") @db.VarChar(50)
  sentBackAt             DateTime?             @map("sent_back_at") @db.Timestamptz(6)
  recurringTransactionId Int?                  @map("recurring_transaction_id")
  voidedById             Int?                  @map("voided_by_id")
  voidedByName           String?               @map("voided_by_name") @db.VarChar(100)
  voidedAt               DateTime?             @map("voided_at") @db.Timestamptz(6)
  voidReason             String?               @map("void_reason") @db.VarChar(500)
  reimbursementStatus    String?               @map("reimbursement_status") @db.VarChar(20)
  reimbursedAt           DateTime?             @map("reimbursed_at") @db.Timestamptz(6)
  reimbursedById         Int?                  @map("reimbursed_by_id")
  reimbursedByName       String?               @map("reimbursed_by_name") @db.VarChar(100)
  reimbursementReference String?               @map("reimbursement_reference") @db.VarChar(150)
  reimbursementNote      String?               @map("reimbursement_note") @db.VarChar(500)
  approvals              ApprovalRequest[]
  notes                  TransactionNote[]
  splits                 TransactionSplit[]
  category               Category?             @relation(fields: [categoryId], references: [id])
  client                 Client?               @relation(fields: [clientId], references: [id])
  product                Product?              @relation(fields: [productId], references: [id])
  project                Project?              @relation(fields: [projectId], references: [id])
  user                   User                  @relation(fields: [userId], references: [id])
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id])
  department             Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  buildOrder             BuildOrder?           @relation(fields: [buildOrderId], references: [id], onDelete: SetNull)
  invoicePayment         InvoicePayment?

  @@index([buildOrderId])
  @@index([userId])
  @@index([dateRecorded])
  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([clientId])
  @@index([projectId])
  @@index([productId])
  @@index([departmentId])
  @@index([contextType])
  @@index([userId, status, type])
  @@index([recurringTransactionId])
  @@map("transactions")
  stockLines StockPurchaseLine[]
  stockMoves StockMove[]
}

model TransactionNote {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  userId        Int         @map("user_id")
  note          String      @db.VarChar(1000)
  createdAt     DateTime    @default(now()) @map("created_at")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@index([transactionId])
  @@map("transaction_notes")
}

model TransactionSplit {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  categoryId    Int         @map("category_id")
  amount        Decimal     @db.Decimal(14, 2)
  description   String?     @db.VarChar(255)
  clientId      Int?        @map("client_id")
  projectId     Int?        @map("project_id")
  productId     Int?        @map("product_id")
  category      Category    @relation(fields: [categoryId], references: [id])
  client        Client?     @relation(fields: [clientId], references: [id])
  project       Project?    @relation(fields: [projectId], references: [id])
  product       Product?    @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([projectId])
  @@index([productId])
  @@map("transaction_splits")
}

model Client {
  id           Int                    @id @default(autoincrement())
  name         String                 @unique @db.VarChar(100)
  description  String?                @db.VarChar(500)
  isActive     Boolean                @default(true) @map("is_active")
  isSystem     Boolean                @default(false) @map("is_system")
  createdBy    Int?                   @map("created_by")
  createdAt    DateTime               @default(now()) @map("created_at")
  address      String?                @db.VarChar(500)
  contactName  String?                @map("contact_name") @db.VarChar(100)
  contactEmail String?                @map("contact_email") @db.VarChar(200)
  contactPhone String?                @map("contact_phone") @db.VarChar(30)
  businessType String?                @map("business_type") @db.VarChar(100)
  code         String?                @db.VarChar(20)
  country      String?                @db.VarChar(100)
  street       String?                @db.VarChar(200)
  addressLine2 String?                @map("address_line2") @db.VarChar(200)
  city         String?                @db.VarChar(100)
  state        String?                @db.VarChar(100)
  postalCode   String?                @map("postal_code") @db.VarChar(20)
  // Tax invoices: the client's GSTIN and how many days it has to pay
  gstin            String?  @db.VarChar(15)
  paymentTermsDays Int      @default(30) @map("payment_terms_days")
  creator      User?                  @relation("ClientCreator", fields: [createdBy], references: [id])
  products     Product[]
  projects     Project[]
  recurringTxn RecurringTransaction[]
  transactions Transaction[]
  allocations  UserAllocation[]
  splitLines   TransactionSplit[]
  buildOrders  BuildOrder[]
  clientPos    ClientPo[]
  invoices     Invoice[]

  @@map("clients")
}

model ProjectType {
  id         Int               @id @default(autoincrement())
  name       String            @db.VarChar(100)
  code       String?           @db.VarChar(10)
  hasJobBom  Boolean           @default(false) @map("has_job_bom")
  isActive   Boolean           @default(true) @map("is_active")
  createdBy  Int?              @map("created_by")
  createdAt  DateTime          @default(now()) @map("created_at")
  creator    User?             @relation("ProjectTypeCreator", fields: [createdBy], references: [id])
  projects   Project[]
  categories ProjectCategory[]

  @@unique([name])
  @@map("project_types")
}

model ClientSector {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("client_sectors")
}

model ProjectCategory {
  id        Int         @id @default(autoincrement())
  typeId    Int         @map("type_id")
  name      String      @db.VarChar(100)
  code      String?     @db.VarChar(10)
  isActive  Boolean     @default(true) @map("is_active")
  createdBy Int?        @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  type      ProjectType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, name])
  @@index([typeId])
  @@map("project_categories")
}

model Project {
  id                            Int                    @id @default(autoincrement())
  clientId                      Int                    @map("client_id")
  typeId                        Int?                   @map("type_id")
  name                          String                 @db.VarChar(100)
  description                   String?                @db.VarChar(500)
  isActive                      Boolean                @default(true) @map("is_active")
  isSystem                      Boolean                @default(false) @map("is_system")
  createdBy                     Int?                   @map("created_by")
  createdAt                     DateTime               @default(now()) @map("created_at")
  code                          String?                @unique @db.VarChar(20)
  status                        String?                @default("Active") @db.VarChar(30)
  lead_id                       Int?
  start_date                    DateTime?              @db.Date
  end_date                      DateTime?              @db.Date
  category                      String?                @db.VarChar(100)
  contractValue                 Decimal?               @map("contract_value") @db.Decimal(14, 2)
  targetMarginPct               Decimal?               @map("target_margin_pct") @db.Decimal(5, 2)
  minMarginPct                  Decimal?               @map("min_margin_pct") @db.Decimal(5, 2)
  riskRating                    String?                @map("risk_rating") @db.VarChar(10)
  client                        Client                 @relation(fields: [clientId], references: [id])
  creator                       User?                  @relation("ProjectCreator", fields: [createdBy], references: [id])
  users_projects_lead_idTousers User?                  @relation("projects_lead_idTousers", fields: [lead_id], references: [id], onUpdate: NoAction)
  type                          ProjectType?           @relation(fields: [typeId], references: [id])
  recurringTxn                  RecurringTransaction[]
  transactions                  Transaction[]
  splitLines                    TransactionSplit[]
  boms                          Bom[]
  clientPos                     ClientPo[]
  invoices                      Invoice[]

  @@unique([clientId, name])
  @@index([typeId])
  @@map("projects")
  stockMoves StockMove[]
}

model ProductType {
  id         Int               @id @default(autoincrement())
  name       String            @db.VarChar(100)
  code       String?           @db.VarChar(10)
  isActive   Boolean           @default(true) @map("is_active")
  createdBy  Int?              @map("created_by")
  createdAt  DateTime          @default(now()) @map("created_at")
  creator    User?             @relation("ProductTypeCreator", fields: [createdBy], references: [id])
  products   Product[]
  categories ProductCategory[]

  @@unique([name])
  @@map("product_types")
}

model ProductCategory {
  id        Int         @id @default(autoincrement())
  typeId    Int         @map("type_id")
  name      String      @db.VarChar(100)
  code      String?     @db.VarChar(10)
  isActive  Boolean     @default(true) @map("is_active")
  createdBy Int?        @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  type      ProductType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, name])
  @@index([typeId])
  @@map("product_categories")
}

model Product {
  id                            Int                    @id @default(autoincrement())
  clientId                      Int                    @map("client_id")
  typeId                        Int?                   @map("type_id")
  name                          String                 @db.VarChar(100)
  description                   String?                @db.VarChar(500)
  isActive                      Boolean                @default(true) @map("is_active")
  isSystem                      Boolean                @default(false) @map("is_system")
  createdBy                     Int?                   @map("created_by")
  createdAt                     DateTime               @default(now()) @map("created_at")
  code                          String?                @unique @db.VarChar(20)
  status                        String?                @default("R&D") @db.VarChar(30)
  lead_id                       Int?
  start_date                    DateTime?              @db.Date
  end_date                      DateTime?              @db.Date
  category                      String?                @db.VarChar(100)
  standardCost                 Decimal?               @map("standard_cost") @db.Decimal(14, 2)
  client                        Client                 @relation(fields: [clientId], references: [id])
  creator                       User?                  @relation("ProductCreator", fields: [createdBy], references: [id])
  users_products_lead_idTousers User?                  @relation("products_lead_idTousers", fields: [lead_id], references: [id], onUpdate: NoAction)
  type                          ProductType?           @relation(fields: [typeId], references: [id])
  recurringTxn                  RecurringTransaction[]
  transactions                  Transaction[]
  splitLines                    TransactionSplit[]
  prices                        ProductPrice[]
  buildOrders                   BuildOrder[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([typeId])
  @@map("products")
}

model RecurringTransaction {
  id              Int               @id @default(autoincrement())
  userId          Int               @map("user_id")
  amount          Decimal           @db.Decimal(14, 2)
  categoryId      Int               @map("category_id")
  description     String?           @db.VarChar(500)
  paymentMethod   String?           @default("cash") @map("payment_method") @db.VarChar(20)
  frequency       String?           @default("monthly") @db.VarChar(20)
  nextRunDate     DateTime          @map("next_run_date") @db.Date
  startDate       DateTime?         @map("start_date") @db.Date
  endDate         DateTime?         @map("end_date") @db.Date
  isActive        Boolean           @default(true) @map("is_active")
  type            String            @default("expense") @db.VarChar(10)
  status          String?           @default("DRAFT") @db.VarChar(20)
  lastRunDate     DateTime?         @map("last_run_date") @db.Timestamptz(6)
  clientId        Int?              @map("client_id")
  projectId       Int?              @map("project_id")
  productId       Int?              @map("product_id")
  departmentId    Int?              @map("department_id")
  renewalDate     DateTime?         @map("renewal_date") @db.Date
  escalationPct   Decimal?          @map("escalation_pct") @db.Decimal(5, 2)
  contextType     String?           @default("project") @map("context_type") @db.VarChar(10)
  currency        String?           @default("INR") @db.VarChar(3)
  gstRate         Decimal?          @map("gst_rate") @db.Decimal(5, 2)
  gstIncluded     Boolean           @default(false) @map("gst_included")
  netAmount       Decimal?          @map("net_amount") @db.Decimal(14, 2)
  totalAmount     Decimal?          @map("total_amount") @db.Decimal(14, 2)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  code            String?           @db.VarChar(20)
  submittedByName String?           @map("submitted_by_name") @db.VarChar(100)
  approvedById    Int?              @map("approved_by_id")
  approvedByName  String?           @map("approved_by_name") @db.VarChar(100)
  approvedByRole  String?           @map("approved_by_role") @db.VarChar(50)
  rejectedById    Int?              @map("rejected_by_id")
  rejectedByName  String?           @map("rejected_by_name") @db.VarChar(100)
  rejectedByRole  String?           @map("rejected_by_role") @db.VarChar(50)
  sentBackById    Int?              @map("sent_back_by_id")
  sentBackByName  String?           @map("sent_back_by_name") @db.VarChar(100)
  sentBackByRole  String?           @map("sent_back_by_role") @db.VarChar(50)
  category        Category          @relation(fields: [categoryId], references: [id])
  client          Client?           @relation(fields: [clientId], references: [id])
  product         Product?          @relation(fields: [productId], references: [id])
  project         Project?          @relation(fields: [projectId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  transactions    Transaction[]
  approvalReqs    ApprovalRequest[]

  @@index([userId])
  @@index([nextRunDate])
  @@index([isActive, nextRunDate])
  @@map("recurring_transactions")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  tableName   String   @map("table_name") @db.VarChar(50)
  recordId    Int      @map("record_id")
  referenceId String?  @map("reference_id") @db.VarChar(20)
  action      String   @db.VarChar(10)
  changedBy   Int      @map("changed_by")
  changedAt   DateTime @default(now()) @map("changed_at")
  oldValues   String?  @map("old_values")
  newValues   String?  @map("new_values")
  user        User     @relation(fields: [changedBy], references: [id])

  @@index([tableName])
  @@index([changedAt])
  @@index([changedBy])
  @@map("audit_log")
}

model ApprovalRule {
  id             Int     @id @default(autoincrement()) @map("rule_id")
  conditionType  String  @map("condition_type") @db.VarChar(50)
  conditionValue String  @map("condition_value") @db.VarChar(100)
  requiredLevels Int     @default(1) @map("required_levels") @db.SmallInt
  targetRoles    String? @map("target_roles") @db.VarChar(500)

  @@map("approval_rules")
}

model ApprovalRequest {
  id                     Int                   @id @default(autoincrement()) @map("request_id")
  transactionId          Int?                  @map("transaction_id")
  recurringTransactionId Int?                  @map("recurring_transaction_id")
  approverId             Int?                  @map("approver_id")
  levelNum               Int                   @map("level_num") @db.SmallInt
  status                 String?               @default("PENDING") @db.VarChar(20)
  comments               String?               @db.VarChar(1000)
  actionDate             DateTime?             @map("action_date")
  createdAt              DateTime              @default(now()) @map("created_at")
  resolvedAt             DateTime?             @map("resolved_at")
  approver               User?                 @relation(fields: [approverId], references: [id])
  transaction            Transaction?          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([recurringTransactionId])
  @@index([approverId])
  @@map("approval_requests")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String   @default("info") @db.VarChar(50)
  title       String   @db.VarChar(200)
  message     String?
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    Int?     @map("entity_id")
  referenceId String?  @map("reference_id") @db.VarChar(20)
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Department {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(100)
  isActive     Boolean       @default(true) @map("is_active")
  ownerId      Int?          @map("owner_id")
  transactions Transaction[]
  createdBy    Int?          @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("departments")
}

// Groups expense or income categories: Type > Category, e.g. Facilities > Rent
model CategoryType {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(50)
  kind       String     @db.VarChar(10)
  code       String?    @db.VarChar(10)
  appliesTo  String?    @map("applies_to") @db.VarChar(40)
  isActive   Boolean    @default(true) @map("is_active")
  createdBy  Int?       @map("created_by")
  createdAt  DateTime   @default(now()) @map("created_at")
  categories Category[]

  @@unique([kind, name])
  @@map("category_types")
}

// ── Budget control ──────────────────────────────────────────────────────────

// One row (id 1): company-wide budget rules
model BudgetSetting {
  id                Int      @id @default(1)
  fyStartMonth      Int      @default(4) @map("fy_start_month") @db.SmallInt
  overBudgetMode    String   @default("WARN") @map("over_budget_mode") @db.VarChar(10)
  controlLevel      String   @default("TYPE") @map("control_level") @db.VarChar(10)
  netOfClaimableGst Boolean  @default(true) @map("net_of_claimable_gst")
  approvalThreshold Decimal  @default(100000) @map("approval_threshold") @db.Decimal(14, 2)
  contingencyPct    Decimal  @default(10) @map("contingency_pct") @db.Decimal(5, 2)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("budget_settings")
}

// One plan per financial year; fy is the calendar year in which it starts (2026 = FY 2026-27)
model BudgetPlan {
  id              Int          @id @default(autoincrement())
  fy              Int          @unique
  name            String       @db.VarChar(100)
  status          String       @default("DRAFT") @db.VarChar(15)
  envelope        Decimal?     @db.Decimal(14, 2)
  version         Int          @default(1)
  submittedAt     DateTime?    @map("submitted_at")
  submittedByName String?      @map("submitted_by_name") @db.VarChar(100)
  submittedById   Int?         @map("submitted_by_id")
  approvedAt      DateTime?    @map("approved_at")
  approvedById    Int?         @map("approved_by_id")
  approvedByName  String?      @map("approved_by_name") @db.VarChar(100)
  decisionNote    String?      @map("decision_note") @db.VarChar(500)
  createdBy       Int?         @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")
  lines           BudgetLine[]

  @@map("budget_plans")
}

// One cost object x one expense type, phased by month
model BudgetLine {
  id            Int                @id @default(autoincrement())
  planId        Int                @map("plan_id")
  costObject    String             @map("cost_object") @db.VarChar(12)
  projectId     Int?               @map("project_id")
  productId     Int?               @map("product_id")
  buildOrderId  Int?               @map("build_order_id")
  departmentId  Int?               @map("department_id")
  typeId        Int?               @map("type_id")
  categoryId    Int?               @map("category_id")
  controlLevel  String             @default("TYPE") @map("control_level") @db.VarChar(10)
  strict        Boolean            @default(false)
  isContingency Boolean            @default(false) @map("is_contingency")
  ownerId       Int?               @map("owner_id")
  note          String?            @db.VarChar(500)
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at")
  plan          BudgetPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  buildOrder    BuildOrder?        @relation(fields: [buildOrderId], references: [id], onDelete: Cascade)
  periods       BudgetLinePeriod[]

  @@index([planId])
  @@index([projectId])
  @@index([productId])
  @@index([buildOrderId])
  @@index([departmentId])
  @@index([typeId])
  @@map("budget_lines")
}

model BudgetLinePeriod {
  id     Int        @id @default(autoincrement())
  lineId Int        @map("line_id")
  year   Int        @db.SmallInt
  month  Int        @db.SmallInt
  amount Decimal    @default(0) @db.Decimal(14, 2)
  line   BudgetLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, year, month])
  @@map("budget_line_periods")
}

model BudgetAlertRule {
  code      String   @id @db.VarChar(30)
  name      String   @db.VarChar(100)
  detail    String?  @db.VarChar(300)
  enabled   Boolean  @default(true)
  threshold Decimal? @db.Decimal(8, 2)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("budget_alert_rules")
}

// One open alert per rule and line; it escalates instead of repeating and closes when the condition clears
model BudgetAlert {
  id         Int       @id @default(autoincrement())
  ruleCode   String    @map("rule_code") @db.VarChar(30)
  lineId     Int?      @map("line_id")
  level      String    @db.VarChar(10)
  message    String    @db.VarChar(300)
  action     String?   @db.VarChar(30)
  ownerId    Int?      @map("owner_id")
  status     String    @default("OPEN") @db.VarChar(10)
  openedAt   DateTime  @default(now()) @map("opened_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([status])
  @@index([lineId])
  @@map("budget_alerts")
}

// Budget control, phases 2 to 5

model RateCard {
  id            Int      @id @default(autoincrement())
  role          String   @db.VarChar(80)
  ratePerHour   Decimal  @map("rate_per_hour") @db.Decimal(10, 2)
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Date
  isActive      Boolean  @default(true) @map("is_active")
  history       RateCardHistory[]

  @@map("rate_cards")
}

// Every rate a role has had, with the date it took effect; the rate in force today is the latest one on or before today
model RateCardHistory {
  id            Int      @id @default(autoincrement())
  rateCardId    Int      @map("rate_card_id")
  ratePerHour   Decimal  @map("rate_per_hour") @db.Decimal(10, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  changedByName String?  @map("changed_by_name") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  rateCard      RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@unique([rateCardId, effectiveFrom])
  @@map("rate_card_history")
}

// What was paid for a part and when; the newest entry is the part's last paid price
model ItemPriceLog {
  id             Int      @id @default(autoincrement())
  itemId         Int      @map("item_id")
  price          Decimal  @db.Decimal(12, 2)
  paidOn         DateTime @map("paid_on") @db.Date
  supplier       String?  @db.VarChar(150)
  note           String?  @db.VarChar(200)
  recordedByName String?  @map("recorded_by_name") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_price_log")
}

// The hours the year's overhead is spread over; every pool is recovered over this one figure
model OverheadBase {
  id         Int     @id @default(autoincrement())
  fy         Int     @unique
  baseHours  Decimal @map("base_hours") @db.Decimal(12, 2)

  @@map("overhead_bases")
}

model OverheadRate {
  id         Int     @id @default(autoincrement())
  fy         Int
  name       String  @db.VarChar(80)
  poolAmount Decimal @map("pool_amount") @db.Decimal(14, 2)
  isActive   Boolean @default(true) @map("is_active")

  @@map("overhead_rates")
}

model CostEstimate {
  id             Int            @id @default(autoincrement())
  projectId      Int            @map("project_id")
  version        Int            @default(1)
  contingencyPct Decimal        @default(10) @map("contingency_pct") @db.Decimal(5, 2)
  warrantyPct    Decimal        @default(2) @map("warranty_pct") @db.Decimal(5, 2)
  note           String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at")
  lines          EstimateLine[]

  @@unique([projectId, version])
  @@map("cost_estimates")
}

model EstimateLine {
  id          Int          @id @default(autoincrement())
  estimateId  Int          @map("estimate_id")
  phase       String       @db.VarChar(60)
  typeId      Int?         @map("type_id")
  description String       @db.VarChar(200)
  quantity    Decimal      @db.Decimal(12, 2)
  unit        String       @db.VarChar(20)
  rate        Decimal      @db.Decimal(12, 2)
  basis       String?      @db.VarChar(200)
  estimate    CostEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_lines")
}

// A project estimate is proposed as a baseline and approved like a planned cost; the lines are copied so later edits do not move it
model EstimateBaseline {
  id             Int       @id @default(autoincrement())
  projectId      Int       @map("project_id")
  status         String    @default("PROPOSED") @db.VarChar(10)
  direct         Decimal   @db.Decimal(14, 2)
  contingency    Decimal   @db.Decimal(14, 2)
  warranty       Decimal   @db.Decimal(14, 2)
  total          Decimal   @db.Decimal(14, 2)
  contingencyPct Decimal   @map("contingency_pct") @db.Decimal(5, 2)
  warrantyPct    Decimal   @map("warranty_pct") @db.Decimal(5, 2)
  lines          Json
  proposedById   Int?      @map("proposed_by_id")
  proposedByName String?   @map("proposed_by_name") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  approvedByName String?   @map("approved_by_name") @db.VarChar(100)
  approvedAt     DateTime? @map("approved_at")
  rejectedByName String?   @map("rejected_by_name") @db.VarChar(100)
  rejectedAt     DateTime? @map("rejected_at")
  rejectReason   String?   @map("reject_reason") @db.VarChar(300)

  @@index([projectId])
  @@map("estimate_baselines")
}

// Every change to a project's contract price, with the reason; the first price set needs none
model ProjectPriceChange {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  oldValue      Decimal? @map("old_value") @db.Decimal(14, 2)
  newValue      Decimal? @map("new_value") @db.Decimal(14, 2)
  reason        String?  @db.VarChar(300)
  changedById   Int?     @map("changed_by_id")
  changedByName String?  @map("changed_by_name") @db.VarChar(100)
  changedAt     DateTime @default(now()) @map("changed_at")

  @@index([projectId])
  @@map("project_price_changes")
}

model ProjectMilestone {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  name        String    @db.VarChar(120)
  plannedDate DateTime  @map("planned_date") @db.Date
  doneDate    DateTime? @map("done_date") @db.Date

  @@index([projectId])
  @@map("project_milestones")
}

// Groups for the Part master, such as Electronics or Mechanical; separate from the expense categories
model ItemCategory {
  id        Int     @id @default(autoincrement())
  name      String  @unique @db.VarChar(60)
  isActive  Boolean @default(true) @map("is_active")
  items     Item[]

  @@map("item_categories")
}

model Item {
  id                Int      @id @default(autoincrement())
  partNo            String   @unique @map("part_no") @db.VarChar(40)
  name              String   @db.VarChar(150)
  categoryId        Int?     @map("category_id")
  itemCategory      ItemCategory? @relation(fields: [categoryId], references: [id])
  uom               String   @default("nos") @db.VarChar(12)
  standardPrice     Decimal  @map("standard_price") @db.Decimal(12, 2)
  lastPrice         Decimal? @map("last_price") @db.Decimal(12, 2)
  supplier          String?  @db.VarChar(120)
  // Bought parts: the manufacturer's (OEM) own number for the part; our own part number is partNo
  oemPartNo         String?  @map("oem_part_no") @db.VarChar(60)
  leadTimeDays      Int?     @map("lead_time_days")
  sourcing          String   @default("BUY") @db.VarChar(4)
  materialCost      Decimal? @map("material_cost") @db.Decimal(12, 2)
  manufacturingCost Decimal? @map("manufacturing_cost") @db.Decimal(12, 2)
  isActive          Boolean  @default(true) @map("is_active")
  // Life of the part: ACTIVE, then REPLACED (a successor takes over) or RETIRED (no successor), from statusFrom. Part numbers are never reused
  status            String   @default("ACTIVE") @db.VarChar(10)
  statusFrom        DateTime? @map("status_from") @db.Date
  statusReason      String?  @map("status_reason") @db.VarChar(300)
  replacedById      Int?     @map("replaced_by_id")
  // Parts that meet the same spec share a group; one of them is the default
  alternateGroupId   Int?    @map("alternate_group_id")
  isDefaultAlternate Boolean @default(false) @map("is_default_alternate")
  // A one-off part for a single project's job BOM; other BOMs and pickers never offer it
  projectId         Int?     @map("project_id")
  // DIRECT: charged to the job when bought. STOCK: bought into the Store, charged to a job when used
  supplyMode        String   @default("DIRECT") @map("supply_mode") @db.VarChar(10)
  purchaseUom       String?  @map("purchase_uom") @db.VarChar(12)
  // Stock units in one purchase unit, for example 6 metres in a bar
  purchaseFactor    Decimal? @map("purchase_factor") @db.Decimal(12, 4)
  reorderLevel      Decimal? @map("reorder_level") @db.Decimal(14, 3)
  // The expense category stock used is booked under, so it finds the job's budget line
  stockCategoryId   Int?     @map("stock_category_id")
  stockCategory     Category? @relation(fields: [stockCategoryId], references: [id])
  stockBalance      StockBalance?
  stockMoves        StockMove[]
  purchaseLines     StockPurchaseLine[]
  countLines        StockCountLine[]
  priceLog          ItemPriceLog[]
  replacements      PartReplacement[] @relation("ReplacedPart")
  successions       PartReplacement[] @relation("Successor")

  @@index([alternateGroupId])
  @@index([projectId])

  @@map("items")
}

// A part taken out of use on a date, with the part that takes over (none when it is retired)
model PartReplacement {
  id            Int       @id @default(autoincrement())
  itemId        Int       @map("item_id")
  successorId   Int?      @map("successor_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  reason        String    @db.VarChar(300)
  status        String    @default("SCHEDULED") @db.VarChar(10)
  bomsChanged   Int       @default(0) @map("boms_changed")
  createdById   Int?      @map("created_by_id")
  createdByName String?   @map("created_by_name") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at")
  appliedAt     DateTime? @map("applied_at")
  cancelledAt   DateTime? @map("cancelled_at")
  item          Item      @relation("ReplacedPart", fields: [itemId], references: [id])
  successor     Item?     @relation("Successor", fields: [successorId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([status, effectiveFrom])
  @@index([successorId])
  @@map("part_replacements")
}

model Bom {
  id          Int            @id @default(autoincrement())
  productId   Int?           @map("product_id")
  projectId   Int?           @map("project_id")
  version     Int            @default(1)
  status      String         @default("DRAFT") @db.VarChar(12)
  freightPct  Decimal        @default(2) @map("freight_pct") @db.Decimal(5, 2)
  warrantyPct Decimal        @default(1.5) @map("warranty_pct") @db.Decimal(5, 2)
  // Products only: a rate per hour used in place of the combined overhead rate, with the reason for any adjustment to overhead, freight or warranty
  overheadRateOverride Decimal? @map("overhead_rate_override") @db.Decimal(10, 2)
  adjustReason         String?  @map("adjust_reason") @db.VarChar(300)
  // From when this version is in force, and why it was made (for example a part replaced)
  effectiveFrom        DateTime? @map("effective_from") @db.Date
  changeNote           String?  @map("change_note") @db.VarChar(300)
  // A build order's own copy of a product's BOM; locked apart from swapping a part for one of its alternates
  buildOrderId Int?           @map("build_order_id")
  // Job BOMs: the product BOM it was last started from, so a reimport can offer the same product again
  sourceProductId Int?        @map("source_product_id")
  sourceVersion   Int?        @map("source_version")
  createdAt   DateTime       @default(now()) @map("created_at")
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildOrder  BuildOrder?    @relation(fields: [buildOrderId], references: [id], onDelete: Cascade)
  lines       BomLine[]
  operations  BomOperation[]

  @@unique([productId, version])
  @@unique([projectId, version])
  @@unique([buildOrderId, version])
  @@index([projectId])
  @@map("boms")
}

// A customer's commitment to have units of a standard product built and delivered. Built from an imported, locked copy of the product BOM.
model BuildOrder {
  id                 Int       @id @default(autoincrement())
  code               String    @unique @db.VarChar(20)
  productId          Int       @map("product_id")
  clientId           Int       @map("client_id")
  quantity           Int
  customerPo         String?   @map("customer_po") @db.VarChar(60)
  // COMMITTED, RELEASED, IN_BUILD, DELIVERED or CANCELLED
  status             String    @default("COMMITTED") @db.VarChar(10)
  startDate          DateTime  @map("start_date") @db.Date
  deliveryDate       DateTime  @map("delivery_date") @db.Date
  deliveredOn        DateTime? @map("delivered_on") @db.Date
  unitPrice          Decimal?  @map("unit_price") @db.Decimal(14, 2)
  notes              String?   @db.VarChar(500)
  // What the BOM was copied from, and the approved standard cost of the product at that time
  sourceBomId        Int?      @map("source_bom_id")
  sourceBomVersion   Int?      @map("source_bom_version")
  sourceStandardCost Decimal?  @map("source_standard_cost") @db.Decimal(14, 2)
  importedAt         DateTime? @map("imported_at")
  // Cost of one unit from the order's own BOM, refreshed on import, on a swap and on request
  unitCost           Decimal?  @map("unit_cost") @db.Decimal(14, 2)
  costedAt           DateTime? @map("costed_at")
  cancelReason       String?   @map("cancel_reason") @db.VarChar(300)
  createdBy          Int?      @map("created_by")
  createdByName      String?   @map("created_by_name") @db.VarChar(100)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  product            Product   @relation(fields: [productId], references: [id])
  client             Client    @relation(fields: [clientId], references: [id])
  boms               Bom[]
  transactions       Transaction[]
  budgetLines        BudgetLine[]
  clientPos          ClientPo[]
  invoices           Invoice[]

  @@index([productId, startDate])
  @@index([status])
  @@map("build_orders")
  stockMoves StockMove[]
}

model BomLine {
  id       Int     @id @default(autoincrement())
  bomId    Int     @map("bom_id")
  itemId   Int     @map("item_id")
  // Build orders only: the part this line had when the standard BOM was copied, so a swap to an alternate can be shown and undone
  sourceItemId  Int?     @map("source_item_id")
  // A label that groups parts for a subtotal (for example the arm or the base); it is not a level of the BOM
  groupName String? @map("group_name") @db.VarChar(60)
  // The step of the build the part is needed for. Step 2 starts when step 1 is built; the default of 1 puts everything in one step.
  sequence  Int     @default(1)
  quantity Decimal @db.Decimal(12, 3)
  scrapPct Decimal @default(0) @map("scrap_pct") @db.Decimal(5, 2)
  bom      Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@map("bom_lines")
}

model BomOperation {
  id              Int            @id @default(autoincrement())
  bomId           Int            @map("bom_id")
  name            String         @db.VarChar(120)
  hours           Decimal        @default(0) @db.Decimal(8, 2)
  rateCardId      Int?           @map("rate_card_id")
  outsourcedCost  Decimal?       @map("outsourced_cost") @db.Decimal(12, 2)
  // A fixed amount per unit for an operation costed as a fixed cost (no role or hours)
  fixedCost       Decimal?       @map("fixed_cost") @db.Decimal(12, 2)
  operationTypeId Int?           @map("operation_type_id")
  // The step of the build the work belongs to, matching the sequence of the parts it uses
  sequence        Int            @default(1)
  operationType   OperationType? @relation(fields: [operationTypeId], references: [id], onDelete: SetNull)
  bom             Bom            @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([operationTypeId])
  @@map("bom_operations")
}

model OperationType {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(80)
  isOutsourced Boolean        @default(false) @map("is_outsourced")
  isFixed      Boolean        @default(false) @map("is_fixed")
  isActive     Boolean        @default(true) @map("is_active")
  sortOrder    Int            @default(0) @map("sort_order")
  operations   BomOperation[]

  @@map("operation_types")
}

model EstimatePhase {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(60)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("estimate_phases")
}

model StandardCost {
  id             Int       @id @default(autoincrement())
  productId      Int       @map("product_id")
  bomId          Int       @map("bom_id")
  fy             Int
  material       Decimal   @db.Decimal(14, 2)
  scrap          Decimal   @db.Decimal(14, 2)
  freight        Decimal   @db.Decimal(14, 2)
  conversion     Decimal   @db.Decimal(14, 2)
  outsourced     Decimal   @default(0) @db.Decimal(14, 2)
  fixed          Decimal   @default(0) @db.Decimal(14, 2)
  overhead       Decimal   @db.Decimal(14, 2)
  warranty       Decimal   @db.Decimal(14, 2)
  total          Decimal   @db.Decimal(14, 2)
  status         String    @default("PROPOSED") @db.VarChar(10)
  approvedByName String?   @map("approved_by_name") @db.VarChar(100)
  approvedAt     DateTime? @map("approved_at")
  // What the roll-up used when the figure was proposed, so a planned cost can be explained later
  overheadRate   Decimal?  @map("overhead_rate") @db.Decimal(10, 2)
  freightPct     Decimal?  @map("freight_pct") @db.Decimal(5, 2)
  warrantyPct    Decimal?  @map("warranty_pct") @db.Decimal(5, 2)
  adjustReason   String?   @map("adjust_reason") @db.VarChar(300)
  proposedById   Int?      @map("proposed_by_id")
  proposedByName String?   @map("proposed_by_name") @db.VarChar(100)
  rejectedByName String?   @map("rejected_by_name") @db.VarChar(100)
  rejectedAt     DateTime? @map("rejected_at")
  rejectReason   String?   @map("reject_reason") @db.VarChar(300)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([productId])
  @@map("standard_costs")
}

// What a product is planned to sell for in a financial year, so its margin can be set against the standard cost
model ProductPrice {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  fy            Int
  price         Decimal? @db.Decimal(14, 2)
  // Margins are goals to track against, as a share of the selling price
  targetMarginPct Decimal? @map("target_margin_pct") @db.Decimal(5, 2)
  minMarginPct    Decimal? @map("min_margin_pct") @db.Decimal(5, 2)
  updatedById   Int?     @map("updated_by_id")
  updatedByName String?  @map("updated_by_name") @db.VarChar(100)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, fy])
  @@map("product_prices")
}

model ProductionPlan {
  id           Int @id @default(autoincrement())
  productId    Int @map("product_id")
  year         Int @db.SmallInt
  month        Int @db.SmallInt
  plannedUnits Int @default(0) @map("planned_units")
  actualUnits  Int @default(0) @map("actual_units")

  @@unique([productId, year, month])
  @@map("production_plans")
}

// Transfers between lines, revisions, contingency drawdowns and reserve releases
model BudgetChange {
  id              Int       @id @default(autoincrement())
  kind            String    @db.VarChar(12)
  fromLineId      Int?      @map("from_line_id")
  toLineId        Int?      @map("to_line_id")
  amount          Decimal   @db.Decimal(14, 2)
  reason          String    @db.VarChar(500)
  status          String    @default("PENDING") @db.VarChar(10)
  requestedById   Int?      @map("requested_by_id")
  requestedByName String?   @map("requested_by_name") @db.VarChar(100)
  decidedByName   String?   @map("decided_by_name") @db.VarChar(100)
  decidedAt       DateTime? @map("decided_at")
  decisionNote    String?   @map("decision_note") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("budget_changes")
}

model PeriodLock {
  id           Int      @id @default(autoincrement())
  year         Int      @db.SmallInt
  month        Int      @db.SmallInt
  lockedByName String?  @map("locked_by_name") @db.VarChar(100)
  lockedAt     DateTime @default(now()) @map("locked_at")

  @@unique([year, month])
  @@map("period_locks")
}

model VarianceNote {
  id         Int      @id @default(autoincrement())
  lineId     Int      @map("line_id")
  year       Int      @db.SmallInt
  month      Int      @db.SmallInt
  reasonCode String   @map("reason_code") @db.VarChar(20)
  comment    String?  @db.VarChar(500)
  authorName String?  @map("author_name") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([lineId, year, month])
  @@map("variance_notes")
}

// Client invoicing ---------------------------------------------------------

// Who issues the invoices: one record, shown on every tax invoice
model CompanyProfile {
  id          Int      @id @default(1)
  legalName   String   @map("legal_name") @db.VarChar(150)
  gstin       String?  @db.VarChar(15)
  pan         String?  @db.VarChar(10)
  addressLine String?  @map("address_line") @db.VarChar(300)
  city        String?  @db.VarChar(100)
  state       String?  @db.VarChar(100)
  postalCode  String?  @map("postal_code") @db.VarChar(20)
  email       String?  @db.VarChar(200)
  phone       String?  @db.VarChar(30)
  bankName    String?  @map("bank_name") @db.VarChar(100)
  bankAccount String?  @map("bank_account") @db.VarChar(30)
  bankIfsc    String?  @map("bank_ifsc") @db.VarChar(15)
  bankBranch  String?  @map("bank_branch") @db.VarChar(100)
  bankAddress String?  @map("bank_address") @db.VarChar(300)
  bankAccountName String? @map("bank_account_name") @db.VarChar(150)
  terms       String?  @db.VarChar(1000)
  signatory   String?  @db.VarChar(100)
  footerNote  String?  @map("footer_note") @db.VarChar(300)
  // The company logo as a small image data URL; shown at the head of every invoice
  logo        String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("company_profile")
}

// The running invoice number: one row, increased inside the transaction that issues an invoice, so a number is never used twice
model InvoiceCounter {
  id      Int @id @default(1)
  lastSeq Int @map("last_seq")

  @@map("invoice_counter")
}

// A purchase order a client has sent us
model ClientPo {
  id            Int         @id @default(autoincrement())
  clientId      Int         @map("client_id")
  poNumber      String      @map("po_number") @db.VarChar(60)
  poDate        DateTime    @map("po_date") @db.Date
  value         Decimal     @db.Decimal(14, 2)
  validUntil    DateTime?   @map("valid_until") @db.Date
  projectId     Int?        @map("project_id")
  buildOrderId  Int?        @map("build_order_id")
  // OPEN, CLOSED or CANCELLED; autoClosed marks a PO that closed itself because it was fully invoiced
  status        String      @default("OPEN") @db.VarChar(10)
  autoClosed    Boolean     @default(false) @map("auto_closed")
  filePath      String?     @map("file_path") @db.VarChar(255)
  note          String?     @db.VarChar(500)
  createdBy     Int?        @map("created_by")
  createdByName String?     @map("created_by_name") @db.VarChar(100)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")
  client        Client      @relation(fields: [clientId], references: [id])
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  buildOrder    BuildOrder? @relation(fields: [buildOrderId], references: [id], onDelete: SetNull)
  invoices      Invoice[]

  @@unique([clientId, poNumber])
  @@index([status])
  @@index([projectId])
  @@index([buildOrderId])
  @@map("client_pos")
}

// A tax invoice to a client. The number is given when it is issued; seller and buyer are copied onto it then, so later edits to the client do not change it.
model Invoice {
  id              Int              @id @default(autoincrement())
  number          String?          @unique @db.VarChar(16)
  clientId        Int              @map("client_id")
  poId            Int?             @map("po_id")
  projectId       Int?             @map("project_id")
  buildOrderId    Int?             @map("build_order_id")
  invoiceDate     DateTime         @map("invoice_date") @db.Date
  dueDate         DateTime         @map("due_date") @db.Date
  // INTRA (CGST and SGST) or INTER (IGST), and the state the supply is made in, both fixed when the invoice is issued
  supplyType      String?          @map("supply_type") @db.VarChar(5)
  placeOfSupply   String?          @map("place_of_supply") @db.VarChar(100)
  taxable         Decimal          @default(0) @db.Decimal(14, 2)
  cgst            Decimal          @default(0) @db.Decimal(14, 2)
  sgst            Decimal          @default(0) @db.Decimal(14, 2)
  igst            Decimal          @default(0) @db.Decimal(14, 2)
  roundOff        Decimal          @default(0) @map("round_off") @db.Decimal(6, 2)
  total           Decimal          @default(0) @db.Decimal(14, 2)
  paid            Decimal          @default(0) @db.Decimal(14, 2)
  tds             Decimal          @default(0) @db.Decimal(14, 2)
  // DRAFT, ISSUED, PART_PAID, PAID or CANCELLED
  status          String           @default("DRAFT") @db.VarChar(10)
  notes           String?          @db.VarChar(500)
  // What the printed template shows in its header block; all optional and printed only when filled in
  consignee       String?          @db.VarChar(500)
  deliveryNote    String?          @map("delivery_note") @db.VarChar(60)
  deliveryNoteDate DateTime?       @map("delivery_note_date") @db.Date
  referenceNo     String?          @map("reference_no") @db.VarChar(60)
  referenceDate   DateTime?        @map("reference_date") @db.Date
  despatchDocNo   String?          @map("despatch_doc_no") @db.VarChar(60)
  modeOfPayment   String?          @map("mode_of_payment") @db.VarChar(100)
  despatchThrough String?          @map("despatch_through") @db.VarChar(100)
  destination     String?          @db.VarChar(100)
  termsOfDelivery String?          @map("terms_of_delivery") @db.VarChar(300)
  seller          Json?
  buyer           Json?
  issuedAt        DateTime?        @map("issued_at")
  issuedByName    String?          @map("issued_by_name") @db.VarChar(100)
  cancelReason    String?          @map("cancel_reason") @db.VarChar(300)
  cancelledAt     DateTime?        @map("cancelled_at")
  cancelledByName String?          @map("cancelled_by_name") @db.VarChar(100)
  createdBy       Int?             @map("created_by")
  createdByName   String?          @map("created_by_name") @db.VarChar(100)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  client          Client           @relation(fields: [clientId], references: [id])
  po              ClientPo?        @relation(fields: [poId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  buildOrder      BuildOrder?      @relation(fields: [buildOrderId], references: [id], onDelete: SetNull)
  lines           InvoiceLine[]
  payments        InvoicePayment[]

  @@index([status, dueDate])
  @@index([clientId])
  @@index([poId])
  @@index([projectId])
  @@index([buildOrderId])
  @@map("invoices")
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  sequence    Int
  description String  @db.VarChar(300)
  hsn         String? @db.VarChar(10)
  quantity    Decimal @db.Decimal(12, 3)
  unit        String  @default("nos") @db.VarChar(12)
  rate        Decimal @db.Decimal(14, 2)
  gstRate     Decimal @map("gst_rate") @db.Decimal(5, 2)
  taxable     Decimal @db.Decimal(14, 2)
  cgst        Decimal @default(0) @db.Decimal(14, 2)
  sgst        Decimal @default(0) @db.Decimal(14, 2)
  igst        Decimal @default(0) @db.Decimal(14, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// Money received against an invoice; each one becomes an Income entry
model InvoicePayment {
  id            Int          @id @default(autoincrement())
  invoiceId     Int          @map("invoice_id")
  paidOn        DateTime     @map("paid_on") @db.Date
  amount        Decimal      @db.Decimal(14, 2)
  tds           Decimal      @default(0) @db.Decimal(14, 2)
  method        String?      @db.VarChar(20)
  reference     String?      @db.VarChar(100)
  transactionId Int?         @unique @map("transaction_id")
  createdByName String?      @map("created_by_name") @db.VarChar(100)
  createdAt     DateTime     @default(now()) @map("created_at")
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_payments")
}

// The parts on a stock purchase expense; they become stock when the expense is submitted
model StockPurchaseLine {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  itemId        Int         @map("item_id")
  // In the part's purchase unit
  quantity      Decimal     @db.Decimal(14, 3)
  // Net of GST
  amount        Decimal     @db.Decimal(14, 2)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  item          Item        @relation(fields: [itemId], references: [id])

  @@index([transactionId])
  @@index([itemId])
  @@map("stock_purchase_lines")
}

// Current balance per part, updated in the same database transaction as each ledger entry
model StockBalance {
  itemId   Int     @id @map("item_id")
  quantity Decimal @default(0) @db.Decimal(14, 3)
  value    Decimal @default(0) @db.Decimal(14, 2)
  avgCost  Decimal @default(0) @map("avg_cost") @db.Decimal(14, 4)
  item     Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("stock_balances")
}

// The stock ledger. quantity and value are the signed change to stock
model StockMove {
  id            Int          @id @default(autoincrement())
  itemId        Int          @map("item_id")
  // OPENING, IN (negative when a purchase is reversed), USED, ADJUST
  kind          String       @db.VarChar(10)
  quantity      Decimal      @db.Decimal(14, 3)
  unitCost      Decimal      @map("unit_cost") @db.Decimal(14, 4)
  value         Decimal      @db.Decimal(14, 2)
  movedOn       DateTime     @map("moved_on") @db.Date
  transactionId Int?         @map("transaction_id")
  projectId     Int?         @map("project_id")
  buildOrderId  Int?         @map("build_order_id")
  departmentId  Int?         @map("department_id")
  categoryId    Int?         @map("category_id")
  // A correction to an entry in a closed month, at the same unit cost
  correctsId    Int?         @map("corrects_id")
  countId       Int?         @map("count_id")
  reason        String?      @db.VarChar(300)
  createdById   Int?         @map("created_by_id")
  createdByName String?      @map("created_by_name") @db.VarChar(100)
  createdAt     DateTime     @default(now()) @map("created_at")
  item          Item         @relation(fields: [itemId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  buildOrder    BuildOrder?  @relation(fields: [buildOrderId], references: [id], onDelete: Restrict)
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  corrects      StockMove?   @relation("Correction", fields: [correctsId], references: [id])
  corrections   StockMove[]  @relation("Correction")
  count         StockCount?  @relation(fields: [countId], references: [id])

  @@index([itemId, movedOn])
  @@index([projectId])
  @@index([buildOrderId])
  @@index([transactionId])
  @@index([categoryId])
  @@index([correctsId])
  @@index([countId])
  @@index([kind, movedOn])
  @@map("stock_moves")
}

// One count of the Store for a month: DRAFT, SUBMITTED, APPROVED
model StockCount {
  id              Int              @id @default(autoincrement())
  year            Int              @db.SmallInt
  month           Int              @db.SmallInt
  status          String           @default("DRAFT") @db.VarChar(10)
  createdByName   String?          @map("created_by_name") @db.VarChar(100)
  createdAt       DateTime         @default(now()) @map("created_at")
  submittedByName String?          @map("submitted_by_name") @db.VarChar(100)
  submittedAt     DateTime?        @map("submitted_at")
  approvedByName  String?          @map("approved_by_name") @db.VarChar(100)
  approvedAt      DateTime?        @map("approved_at")
  note            String?          @db.VarChar(300)
  lines           StockCountLine[]
  moves           StockMove[]

  @@unique([year, month])
  @@map("stock_counts")
}

model StockCountLine {
  id          Int        @id @default(autoincrement())
  countId     Int        @map("count_id")
  itemId      Int        @map("item_id")
  // The quantity on the books when the count was approved
  expectedQty Decimal?   @map("expected_qty") @db.Decimal(14, 3)
  countedQty  Decimal?   @map("counted_qty") @db.Decimal(14, 3)
  count       StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item        Item       @relation(fields: [itemId], references: [id])

  @@unique([countId, itemId])
  @@index([itemId])
  @@map("stock_count_lines")
}
