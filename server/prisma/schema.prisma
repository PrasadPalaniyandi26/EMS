// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int        @id @default(autoincrement()) @map("role_id")
  name        String     @unique @map("role_name") @db.VarChar(50)
  description String?    @db.VarChar(255)
  accessLevel String?    @default("Standard") @map("access_level") @db.VarChar(20)
  users       User[]
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  isDefault Boolean  @default(false) @map("is_default")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@map("user_roles")
}

model User {
  id               Int      @id @default(autoincrement())
  username         String   @unique @db.VarChar(50)
  email            String   @unique @db.VarChar(100)
  passwordHash     String   @map("password_hash") @db.VarChar(255)
  role             String?  @default("user") @db.VarChar(10) // Legacy role column
  roleId           Int?     @map("role_id")
  roleRelation     Role?    @relation(fields: [roleId], references: [id])
  userRoles        UserRole[]
  managerId        Int?     @map("manager_id")
  manager          User?    @relation("UserManager", fields: [managerId], references: [id])
  subordinates     User[]   @relation("UserManager")
  isActive         Boolean  @default(true) @map("is_active")
  currency         String?  @default("INR") @db.VarChar(3)
  department       String?  @db.VarChar(100)
  clearanceLevel   String?  @default("Level 1") @map("clearance_level") @db.VarChar(20)
  joiningDate      DateTime? @map("joining_date")
  contactNo    String?  @map("contact_no") @db.VarChar(20)
  houseApt     String?  @map("house_apt") @db.VarChar(100)
  address      String?  @db.VarChar(255)
  city         String?  @db.VarChar(100)
  country      String?  @db.VarChar(100)
  postalCode   String?  @map("postal_code") @db.VarChar(20)
  userStatus   String?  @default("ACTIVE") @map("user_status") @db.VarChar(20)
  permissions  UserPermission?
  createdAt        DateTime @default(now()) @map("created_at")

  transactions     Transaction[]
  refreshTokens    RefreshToken[]
  budgets          Budget[]
  monthlySettings  MonthlyBudgetSetting[]
  recurringTxns    RecurringTransaction[]
  createdClients   Client[]      @relation("ClientCreator")
  createdProjects  Project[]     @relation("ProjectCreator")
  createdProjTypes ProjectType[] @relation("ProjectTypeCreator")
  createdProdTypes ProductType[] @relation("ProductTypeCreator")
  createdProducts  Product[]     @relation("ProductCreator")
  auditLogs        AuditLog[]
  approvalReqs     ApprovalRequest[]
  allocations      UserAllocation[]

  @@map("users")
}

model UserAllocation {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     Int      @map("client_id")
  client       Client   @relation(fields: [clientId], references: [id])
  category     String   @db.VarChar(20) // 'Project' or 'Product'
  type         String   @db.VarChar(50) // 'Development', 'Consulting', etc.
  code         String   @db.VarChar(50) // e.g., 'PRJ-2024-001'
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("user_allocations")
}

model UserPermission {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions  Json     @db.JsonB
  singleLimit  Decimal? @map("single_limit") @db.Decimal(12, 2)
  monthlyLimit Decimal? @map("monthly_limit") @db.Decimal(12, 2)
  dataScope    String?  @default("Department") @map("data_scope") @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user_permissions")
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(50)
  type         String   @db.VarChar(10) // 'income' or 'expense'
  icon         String?  @db.VarChar(50)
  isCustom     Boolean  @default(false) @map("is_custom")
  createdBy    Int?     @map("created_by")
  isActive     Boolean  @default(true) @map("is_active")
  
  transactions Transaction[]
  splits       TransactionSplit[]
  budgets      Budget[]
  recurringTxn RecurringTransaction[]

  @@map("categories")
}

model Transaction {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  type          String   @db.VarChar(10)
  amount        Decimal  @db.Decimal(12, 2)
  dateRecorded  DateTime @db.Date @map("date_recorded")
  categoryId    Int?     @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id])
  description   String?  @db.VarChar(500)
  paymentMethod String?  @default("cash") @map("payment_method") @db.VarChar(20)
  receiptPath   String?  @map("receipt_path") @db.VarChar(255)
  
  // V3 fields
  clientId      Int?     @map("client_id")
  client        Client?  @relation(fields: [clientId], references: [id])
  projectId     Int?     @map("project_id")
  project       Project? @relation(fields: [projectId], references: [id])
  isSplit       Boolean  @default(false) @map("is_split")
  referenceId   String?  @unique @map("reference_id") @db.VarChar(20)
  receiptNumber String?  @map("receipt_number") @db.VarChar(50)
  submittedAt   DateTime? @default(now()) @map("submitted_at")
  status        String?  @default("APPROVED") @db.VarChar(20)
  
  productId     Int?     @map("product_id")
  product       Product? @relation(fields: [productId], references: [id])
  contextType   String?  @default("project") @map("context_type") @db.VarChar(10)
  currency      String?  @default("INR") @db.VarChar(3)

  // Final approver/rejector info (stored on final action only)
  approvedById   Int?     @map("approved_by_id")
  approvedByName String?  @map("approved_by_name") @db.VarChar(100)
  approvedByRole String?  @map("approved_by_role") @db.VarChar(50)
  approvedAt     DateTime? @map("approved_at")
  rejectedById   Int?     @map("rejected_by_id")
  rejectedByName String?  @map("rejected_by_name") @db.VarChar(100)
  rejectedByRole String?  @map("rejected_by_role") @db.VarChar(50)
  rejectedAt     DateTime? @map("rejected_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  splits        TransactionSplit[]
  approvals     ApprovalRequest[]

  @@index([userId])
  @@index([dateRecorded])
  @@index([categoryId])
  @@index([type])
  @@index([clientId])
  @@index([projectId])
  @@index([productId])
  @@index([contextType])
  @@map("transactions")
}

model TransactionSplit {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    Int         @map("category_id")
  category      Category    @relation(fields: [categoryId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  description   String?     @db.VarChar(255)

  @@index([transactionId])
  @@map("transaction_splits")
}

model Client {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(100)
  code         String?  @unique @db.VarChar(20)
  description  String?  @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  isSystem     Boolean  @default(false) @map("is_system")
  createdBy    Int?     @map("created_by")
  creator      User?    @relation("ClientCreator", fields: [createdBy], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  address      String?  @db.VarChar(500)
  country      String?  @db.VarChar(100)
  contactName  String?  @map("contact_name") @db.VarChar(100)
  contactEmail String?  @map("contact_email") @db.VarChar(200)
  contactPhone String?  @map("contact_phone") @db.VarChar(30)
  businessType String?  @map("business_type") @db.VarChar(100)

  projects     Project[]
  projectTypes ProjectType[]
  productTypes ProductType[]
  products     Product[]
  transactions Transaction[]
  recurringTxn RecurringTransaction[]
  allocations  UserAllocation[]

  @@map("clients")
}

model ProjectType {
  id        Int      @id @default(autoincrement())
  clientId  Int      @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdBy Int?     @map("created_by")
  creator   User?    @relation("ProjectTypeCreator", fields: [createdBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  projects  Project[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("project_types")
}

model Project {
  id          Int      @id @default(autoincrement())
  clientId    Int      @map("client_id")
  client      Client   @relation(fields: [clientId], references: [id])
  typeId      Int?     @map("type_id")
  type        ProjectType? @relation(fields: [typeId], references: [id])
  name        String   @db.VarChar(100)
  code        String?  @unique @db.VarChar(20)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  createdBy   Int?     @map("created_by")
  creator     User?    @relation("ProjectCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  transactions Transaction[]
  recurringTxn RecurringTransaction[]

  @@unique([clientId, name])
  @@index([typeId])
  @@map("projects")
}

model ProductType {
  id        Int      @id @default(autoincrement())
  clientId  Int?     @map("client_id")
  client    Client?  @relation(fields: [clientId], references: [id])
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdBy Int?     @map("created_by")
  creator   User?    @relation("ProductTypeCreator", fields: [createdBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  products  Product[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("product_types")
}

model Product {
  id          Int      @id @default(autoincrement())
  clientId    Int      @map("client_id")
  client      Client   @relation(fields: [clientId], references: [id])
  typeId      Int?     @map("type_id")
  type        ProductType? @relation(fields: [typeId], references: [id])
  name        String   @db.VarChar(100)
  code        String?  @unique @db.VarChar(20)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  createdBy   Int?     @map("created_by")
  creator     User?    @relation("ProductCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  transactions Transaction[]
  recurringTxn RecurringTransaction[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([typeId])
  @@map("products")
}

model RecurringTransaction {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  categoryId    Int      @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id])
  code          String?  @db.VarChar(20)
  description   String?  @db.VarChar(500)
  paymentMethod String?  @default("cash") @map("payment_method") @db.VarChar(20)
  frequency     String?  @default("monthly") @db.VarChar(20)
  nextRunDate   DateTime @db.Date @map("next_run_date")
  isActive      Boolean  @default(true) @map("is_active")
  
  clientId      Int?     @map("client_id")
  client        Client?  @relation(fields: [clientId], references: [id])
  projectId     Int?     @map("project_id")
  project       Project? @relation(fields: [projectId], references: [id])
  productId     Int?     @map("product_id")
  product       Product? @relation(fields: [productId], references: [id])
  contextType   String?  @default("project") @map("context_type") @db.VarChar(10)
  currency      String?  @default("INR") @db.VarChar(3)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([nextRunDate])
  @@map("recurring_transactions")
}

model Budget {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  categoryId  Int?     @map("category_id")
  category    Category? @relation(fields: [categoryId], references: [id])
  code        String?  @db.VarChar(20)
  monthlyLimit Decimal? @map("monthly_limit") @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  periodMonth Int      @default(1) @map("period_month") @db.SmallInt
  periodYear  Int      @default(2025) @map("period_year") @db.SmallInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, categoryId, periodMonth, periodYear])
  @@index([userId])
  @@index([periodYear, periodMonth])
  @@map("budgets")
}

model MonthlyBudgetSetting {
  id                  Int      @id @default(autoincrement())
  userId              Int      @map("user_id")
  user                User     @relation(fields: [userId], references: [id])
  periodMonth         Int      @map("period_month") @db.SmallInt
  periodYear          Int      @map("period_year") @db.SmallInt
  additionalExpense   Decimal? @default(0) @map("additional_expense") @db.Decimal(12, 2)
  lastMonthIncome     Decimal? @default(0) @map("last_month_income") @db.Decimal(12, 2)
  additionalAllocation Decimal? @default(0) @map("additional_allocation") @db.Decimal(12, 2)
  rolloverEnabled     Boolean  @default(false) @map("rollover_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, periodMonth, periodYear])
  @@index([periodYear, periodMonth])
  @@map("monthly_budget_settings")
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  tokenHash   String   @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  tableName   String   @map("table_name") @db.VarChar(50)
  recordId    Int      @map("record_id")
  referenceId String?  @map("reference_id") @db.VarChar(20)
  action      String   @db.VarChar(10)
  changedBy   Int      @map("changed_by")
  user        User     @relation(fields: [changedBy], references: [id])
  changedAt   DateTime @default(now()) @map("changed_at")
  oldValues   String?  @map("old_values") @db.Text
  newValues   String?  @map("new_values") @db.Text

  @@index([tableName])
  @@index([changedAt])
  @@index([changedBy])
  @@map("audit_log")
}

model ApprovalRule {
  id             Int      @id @default(autoincrement()) @map("rule_id")
  conditionType  String   @map("condition_type") @db.VarChar(50)
  conditionValue String   @map("condition_value") @db.VarChar(100)
  requiredLevels Int      @default(1) @map("required_levels") @db.SmallInt
  targetRoles    String?  @map("target_roles") @db.VarChar(500)

  @@map("approval_rules")
}

model ApprovalRequest {
  id            Int         @id @default(autoincrement()) @map("request_id")
  transactionId Int         @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  approverId    Int?        @map("approver_id")
  approver      User?       @relation(fields: [approverId], references: [id])
  levelNum      Int         @map("level_num") @db.SmallInt
  status        String?     @default("PENDING") @db.VarChar(20)
  comments      String?     @db.VarChar(1000)
  actionDate    DateTime?   @map("action_date")
  createdAt     DateTime    @default(now()) @map("created_at") 
  resolvedAt    DateTime?   @map("resolved_at") 

  @@index([transactionId])
  @@index([approverId])
  @@map("approval_requests")
}
